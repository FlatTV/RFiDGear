<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="RFiDGear.UI.MVVMDialogs.View.CustomDialogBox"
    
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding Caption}"
    Width="350"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    HorizontalContentAlignment="Left"
    FontFamily="Segoe UI"
    FontWeight="Normal"
    SizeToContent="Height">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConv" />
    </Window.Resources>
    <Grid Margin="8,8,8,8">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox
            Grid.Row="0"
            Grid.Column="0"
            Width="auto"
            Height="auto"
            Margin="8,8,8,0"
            BorderBrush="Transparent"
            VerticalAlignment="Stretch"
            IsReadOnly="True"
            Focusable="False"
            Text="{Binding Message}"
            TextWrapping="Wrap" />
        <Grid Grid.Row="1" Margin="8,10,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Visibility="{Binding ShowNavigation, Converter={StaticResource BoolToVisConv}}">
                <Button
                    Width="32"
                    Height="26"
                    Margin="0,0,4,0"
                    Padding="0"
                    FontSize="14"
                    Command="{Binding PreviousCommand}"
                    Content="◀"
                    IsEnabled="{Binding IsPreviousEnabled}"
                    ToolTip="Zurück" />
                <Button
                    Width="32"
                    Height="26"
                    Padding="0"
                    FontSize="14"
                    Command="{Binding NextCommand}"
                    Content="▶"
                    IsEnabled="{Binding IsNextEnabled}"
                    ToolTip="Vor" />
            </StackPanel>
            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Width="75"
                    Height="26"
                    Margin="0,0,6,0"
                    Padding="5,2"
                    Command="{Binding OkCommand}"
                    Content="Ok" />
                <Button
                    Width="75"
                    Height="26"
                    Padding="5,2"
                    Command="{Binding CancelCommand}"
                    Content="Cancel"
                    IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>